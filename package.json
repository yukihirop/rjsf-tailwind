{
	"name": "rjsf-tailwind",
	"version": "1.0.0",
	"description": "React JSON Schema Form components with Tailwind CSS styling",
	"type": "module",
	"main": "./dist-lib/rjsf-tailwind.cjs.js",
	"module": "./dist-lib/rjsf-tailwind.es.js",
	"types": "./dist-lib/index.d.ts",
	"exports": {
		".": {
			"import": "./dist-lib/rjsf-tailwind.es.js",
			"require": "./dist-lib/rjsf-tailwind.cjs.js",
			"types": "./dist-lib/index.d.ts"
		}
	},
	"files": [
		"dist-lib",
		"README.md"
	],
	"keywords": [
		"react",
		"json-schema",
		"form",
		"tailwind",
		"rjsf",
		"components",
		"ui"
	],
	"author": "Your Name",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/yukihirop/rjsf-tailwind.git"
	},
	"bugs": {
		"url": "https://github.com/yukihirop/rjsf-tailwind/issues"
	},
	"homepage": "https://github.com/yukihirop/rjsf-tailwind#readme",
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"build:lib": "vite build --config vite.lib.config.ts",
		"lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
		"preview": "vite preview",
		"prepublishOnly": "npm run build:lib",
		"spell": "cspell lint --no-progress",
		"spell:ci": "cspell lint --no-progress --gitignore --no-must-find-files"
	},
	"dependencies": {
		"@radix-ui/react-dropdown-menu": "^2.0.6",
		"@radix-ui/react-slot": "^1.0.2",
		"@react-icons/all-files": "^4.1.0",
		"@rjsf/core": "^5.13.2",
		"@rjsf/utils": "^5.13.2",
		"@rjsf/validator-ajv8": "^5.13.2",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.0.0",
		"json-schema": "^0.4.0",
		"lucide-react": "^0.279.0",
		"monaco-editor": "^0.44.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-router-dom": "^6.16.0",
		"tailwind-merge": "^1.14.0",
		"tailwindcss-animate": "^1.0.7",
		"zustand": "^4.4.3"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "^4.1.1",
		"@tailwindcss/forms": "^0.5.6",
		"@types/node": "^20.8.0",
		"@types/react": "^18.2.15",
		"@types/react-dom": "^18.2.7",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"@vitejs/plugin-react": "^4.0.3",
		"autoprefixer": "^10.4.16",
		"cspell": "^9.2.2",
		"eslint": "^8.45.0",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-react-hooks": "^4.6.0",
		"eslint-plugin-react-refresh": "^0.4.3",
		"eslint-plugin-tailwindcss": "^3.13.0",
		"postcss": "^8.4.31",
		"prettier": "^3.0.3",
		"prettier-plugin-tailwindcss": "^0.5.6",
		"tailwindcss": "^3.3.3",
		"typescript": "^5.0.2",
		"vite": "^4.4.5",
		"vite-plugin-dts": "^3.6.4"
	}
}
